output/**/shorts/*_video.mp4
diagnostics/stills/

# Remotion
out/
.remotion/

# v2 delivery encode: ~590 MB at 8 Mbps (over GitHub's 100 MB limit) + encoder temp files
output/**/full/full_video_v2.mp4
output/**/full/s01_fix.mp4
output/**/full/x264*

# final delivery: ~760 MB master (over GitHub's 100 MB limit) + render chunks
output/**/final/*.mp4
output/**/final/parts/
output/**/final/x264*

# episode 002: raw review stills (contact sheets in diagnostics/ep002_sheets* are kept) + delivery video
diagnostics/ep002_stills*/
episode002/*.mp4
output/**/final/*_x264*

# episode 003: raw review stills (contact sheets are kept) + delivery videos
diagnostics/ep003_stills*/
episode003/*.mp4
.venv-cbx

# episode 004: 3D shot renders (regenerated by `node scripts/pipeline.mjs shots --episode 004`)
output/**/shots/*/char/
output/**/shots/*/*.mp4
output/**/shots/*/still_*.png
output/**/shots/*/char_list.txt
output/**/shots/*/feather.pgm
output/**/audio/narration_kokoro_michael/
blender/**/__pycache__/
output/**/shots/*/plate.png
output/**/shots/render.log
output/**/shots/*/meta.json
# shot manifest changes after every composited shot; the final version is force-added at delivery
output/**/shots/manifest.json
output/episode-004/thumbnails/plate_*.png
