# dependencies / environments
node_modules/
.venv/
__pycache__/
*.pyc

# large or regenerable binaries
models/*.onnx
models/*.bin
output/**/audio/narration/
output/**/audio/cache/
output/**/audio/*/stem_*.wav
output/**/audio/*/mix.wav
